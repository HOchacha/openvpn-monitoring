# OpenVPN writes with log-append and keeps the file open for the life of the
# process, so the log grows without bound. copytruncate rotates it in place;
# signalling OpenVPN to reopen would restart the tunnel and disconnect every
# client, which is far too high a price for a log rotation.
/var/log/openvpn/*.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    create 0600 root root
}
